{
  "name": "@tnvios/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node-telemetry.d.ts",
      "default": "./dist/node-telemetry.js"
    },
    "./logging": {
      "types": "./dist/log-telemetry.d.ts",
      "default": "./dist/log-telemetry.js"
    },
    "./request": {
      "types": "./dist/request-telemetry.d.ts",
      "default": "./dist/request-telemetry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.218.0",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@tnvios/request-context": "workspace:*"
  },
  "devDependencies": {
    "@tnvios/eslint-config": "workspace:*",
    "@tnvios/typescript-config": "workspace:*",
    "@types/node": "25.9.2",
    "eslint": "10.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
