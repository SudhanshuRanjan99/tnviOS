{
  "name": "@tnvios/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./users": {
      "types": "./dist/user.entity.d.ts",
      "default": "./dist/user.entity.js"
    },
    "./keycloak-sync": {
      "types": "./dist/keycloak-sync.d.ts",
      "default": "./dist/keycloak-sync.js"
    },
    "./first-login": {
      "types": "./dist/first-login-provisioner.d.ts",
      "default": "./dist/first-login-provisioner.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.4",
    "@tnvios/database": "workspace:*"
  },
  "devDependencies": {
    "@tnvios/eslint-config": "workspace:*",
    "@tnvios/typescript-config": "workspace:*",
    "@types/node": "25.9.2",
    "eslint": "10.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
