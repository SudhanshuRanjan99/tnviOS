{
  "name": "@tnvios/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "default": "./dist/environment.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tnvios/eslint-config": "workspace:*",
    "@tnvios/typescript-config": "workspace:*",
    "@types/node": "25.9.2",
    "eslint": "10.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
